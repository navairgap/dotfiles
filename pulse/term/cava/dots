#!/usr/bin/env python3
# cava as dots, the pulse matrix from nothing phones: terminal cava only draws bars, so i take its raw numbers
# and print the ● matrix myself. sound and smoothing come from the config next to this. ctrl+c to leave
import configparser, os, shutil, subprocess, sys, tempfile

CONFIG = os.path.join(os.path.dirname(os.path.realpath(__file__)), "config")
ON, OFF = "●", "\x1b[90m●\x1b[39m"  # a dead dot is color8 grey (light in the light theme), like an unlit led


def run(cols, rows):
    cfg = configparser.ConfigParser(interpolation=None, strict=False)
    cfg.read(CONFIG)
    cfg.remove_section("output")
    cfg.read_dict({
        # dot plus space: a terminal cell is twice as narrow as it is tall, so this keeps the grid square
        # even: stereo cava (the default) won't take an odd bar count
        "general": {"bars": str(cols // 4 * 2)},
        "output": {"method": "raw", "raw_target": "/dev/stdout", "data_format": "ascii",
                   "ascii_max_range": str(rows), "bar_delimiter": "59", "frame_delimiter": "10"},
    })
    with tempfile.NamedTemporaryFile("w", suffix=".conf") as f:
        cfg.write(f)
        f.flush()
        with subprocess.Popen(["cava", "-p", f.name], stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True) as p:
            sys.stdout.write("\x1b[2J")  # window got smaller — without this the old frame would linger right and below
            for line in p.stdout:
                if shutil.get_terminal_size() != (cols, rows):
                    p.terminate()
                    return True  # resized — start over for the new size
                try:
                    v = [int(x) for x in line.strip().split(";") if x]
                except ValueError:
                    continue  # before dying cava prints a window title (\e]0;cava\a) into stdout — not a frame; the error comes below
                rows_out = (" ".join(ON if h >= r else OFF for h in v) for r in range(rows, 0, -1))
                sys.stdout.write("\x1b[H" + "\n".join(rows_out))
                sys.stdout.flush()
            sys.exit(p.stderr.read() or None)  # cava died — say why, once the screen is handed back


if sys.argv[1:]:
    os.execvp("cava", ["cava", *sys.argv[1:]])  # flags (cava -v, -p …) mean plain cava

sys.stdout.write("\x1b[?1049h\x1b[?25l")  # my own screen, no cursor
try:
    while run(*shutil.get_terminal_size()):
        pass
except KeyboardInterrupt:
    pass
finally:
    sys.stdout.write("\x1b[?25h\x1b[?1049l")
