# nothing dunst — quiet until it isn't

[global]
    monitor = 0
    follow = mouse
    width = 360
    height = 200
    origin = top-right
    offset = 12x44
    corner_radius = 10
    progress_bar_corner_radius = 5
    frame_width = 1
    frame_color = "#141414"
    separator_color = frame
    font = JetBrains Mono 11
    foreground = "#f5f5f5"
    background = "#000000"
    timeout = 5
    sticky_history = true
    history_length = 30
    icon_position = left
    min_icon_size = 24
    max_icon_size = 32

[urgency_low]
    foreground = "#8a8a8a"
    timeout = 3

[urgency_normal]
    foreground = "#f5f5f5"
    timeout = 5

[urgency_critical]
    frame_color = "#ff3122"
    foreground = "#ff3122"
    timeout = 0
